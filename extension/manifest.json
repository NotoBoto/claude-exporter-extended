{
  "manifest_version": 3,
  "name": "Claude Exporter Extended",
  "version": "1.0.0",
  "description": "Экспорт чатов, артефактов, проектов и изображений из Claude.ai без ограничений: JSON, Markdown, TXT, HTML/PDF.",
  "permissions": ["storage", "downloads", "scripting", "tabs", "contextMenus"],
  "host_permissions": ["https://claude.ai/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["lib/jszip.min.js", "lib/api.js", "lib/core.js", "lib/exporter.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "export-current": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Экспортировать текущий чат"
    },
    "open-browser": {
      "suggested_key": { "default": "Alt+Shift+B" },
      "description": "Открыть менеджер чатов"
    }
  }
}
